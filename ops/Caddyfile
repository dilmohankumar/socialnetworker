# Caddy obtains and renews Let's Encrypt certificates automatically for the site address(es).
{$SITE_ADDRESS:localhost} {
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# API -> Node container
	handle /api/* {
		reverse_proxy api:5000
	}

	# Fingerprinted build assets: cache hard, and a missing file is a real 404 (no SPA fallback)
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Static site (single-page app)
	handle {
		root * /srv
		@config path /config.js
		header @config Cache-Control "no-store"
		try_files {path} /index.html
		file_server
	}
}
